# Database
DATABASE_URL=postgresql+asyncpg://user:password@db:5432/spending_tracker

# OCR provider: tesseract (default, no key needed) | claude | openai
OCR_PROVIDER=tesseract

# Required only if OCR_PROVIDER=claude
ANTHROPIC_API_KEY=

# Required only if OCR_PROVIDER=openai
OPENAI_API_KEY=

# Upload directory for statement files (default is fine for Docker)
UPLOAD_DIR=/tmp/spending-tracker-uploads

# Storage backends (comma-separated: local, s3, gcs). Default = local only.
# STORAGE_BACKENDS=local
# STORAGE_BACKENDS=local,s3
# STORAGE_BACKENDS=local,s3,gcs

# Required only if STORAGE_BACKENDS includes 's3'
# AWS_S3_BUCKET=my-bucket
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=us-east-1

# Required only if STORAGE_BACKENDS includes 'gcs' (omit for ADC / Workload Identity)
# GCS_BUCKET=my-bucket
# GCS_PROJECT_ID=
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account-key.json

# Nginx port (default 80)
# NGINX_PORT=80

# Exchange rate DB path inside the container (matches docker-compose volume mount)
# RATES_DB_PATH=/data/rates/exchange_rates.db

# URL to bootstrap the exchange rate DB on first 'docker compose up'.
# Leave empty to start with an empty DB (rates fetched on demand from Frankfurter).
# Set to the GitHub Releases URL to download a pre-seeded artifact:
# RATES_DB_URL=https://github.com/<owner>/spending-tracker/releases/download/rates-latest/exchange_rates.db
