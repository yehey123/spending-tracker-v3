# Database credentials — set your own values, never commit the real .env
DB_USER=
DB_PASSWORD=
DATABASE_URL=postgresql+asyncpg://<same-as-DB_USER>:<same-as-DB_PASSWORD>@db:5432/spending_tracker

# OCR provider: tesseract (default, no key needed) | claude | openai
OCR_PROVIDER=tesseract

# Required only if OCR_PROVIDER=claude
ANTHROPIC_API_KEY=

# Required only if OCR_PROVIDER=openai
OPENAI_API_KEY=

# Environment (default: production). Set to "development" to enable dev-only features
# such as the dev_mode toggle in Settings (skips AI categorisation).
# APP_ENV=development

# Nginx port (default 80)
# NGINX_PORT=80

# Exchange rate DB path inside the container (matches docker-compose volume mount)
# RATES_DB_PATH=/data/rates/exchange_rates.db

# URL to bootstrap the exchange rate DB on first 'docker compose up'.
# Leave empty to start with an empty DB (rates fetched on demand from Frankfurter).
# Set to the GitHub Releases URL to download a pre-seeded artifact:
# RATES_DB_URL=https://github.com/<owner>/spending-tracker/releases/download/rates-latest/exchange_rates.db

# API token authentication: empty disables API authentication (single-user localhost default); set to a long random string to require an X-API-Token header on every request.
API_TOKEN=

# CORS origins: comma-separated list of allowed browser origins; empty falls back to localhost + Capacitor mobile defaults.
CORS_ORIGINS=
